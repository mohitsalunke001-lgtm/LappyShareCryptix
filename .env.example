# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Database
# Uses SQLite in instance/lappyshare.db by default
DATABASE_URL=sqlite:///lappyshare.db

# Optional SMTP Email Configuration (for real password reset emails)
# If left blank, password reset links will be generated securely and shown in the UI/console for development
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER="LappyShare Campus <noreply@lappyshare.edu>"

# Security & Uploads
MAX_CONTENT_LENGTH=10485760  # 10MB upload limit
UPLOAD_FOLDER=app/static/uploads
